# NetSentinel — Environment Variables Example
#
# Copy this file to .env and adjust values for your local environment.
# Never commit the .env file.

# Application
APP_NAME=NetSentinel
LOG_LEVEL=INFO

# Scanning
SCAN_TIMEOUT=3.0
SCAN_MAX_CONCURRENCY=50
MONITOR_INTERVAL=30

# Database (v0.3)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Leave URLs empty to use scan/monitor without persistence.
# Runtime: postgresql+asyncpg://netsentinel_app:<encoded-password>@127.0.0.1:5432/netsentinel
DATABASE_URL=
# Migrations: postgresql+asyncpg://netsentinel:<encoded-admin-password>@127.0.0.1:5432/netsentinel
MIGRATION_DATABASE_URL=

# Required by Docker Compose; set two different, randomly generated secrets.
# Never use the old public password. Changing these does not rotate an existing DB.
POSTGRES_PASSWORD=
NETSENTINEL_DB_PASSWORD=

# Alert Severities (v0.4.0)
# Accepted values (case-insensitive): INFO, LOW, MEDIUM, HIGH, CRITICAL
ALERT_SEVERITY_NEW_OPEN_PORT=HIGH
ALERT_SEVERITY_PORT_CLOSED=LOW
ALERT_SEVERITY_HOST_DOWN=MEDIUM
ALERT_SEVERITY_HOST_RECOVERED=INFO

# Expected TCP Ports Policy (v0.4.0)
# Comma-separated list of expected TCP ports (e.g. 22,80,443).
# Leave empty to disable expected ports policy (legacy NEW_OPEN_PORT rule applies).
# Note: EXPECTED_TCP_PORTS only classifies opened ports; it does NOT alter --ports scanned.
EXPECTED_TCP_PORTS=
ALERT_SEVERITY_EXPECTED_OPEN_PORT=INFO
ALERT_SEVERITY_UNEXPECTED_OPEN_PORT=HIGH

